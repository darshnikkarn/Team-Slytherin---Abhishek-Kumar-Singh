# ---- Core ----
APP_NAME="Study Planner Agent"
ENV=dev
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Database ----
# SQLite by default (zero config). Swap to Postgres with:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/studyplanner
DATABASE_URL=sqlite:///./studyplanner.db

# ---- LLM (Google Gemini) ----
# Free key: https://aistudio.google.com/apikey
# If empty, the agent falls back to the deterministic engine + heuristic
# parsers, so nothing hard-fails during a live demo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

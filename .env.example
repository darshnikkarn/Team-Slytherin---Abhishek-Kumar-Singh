# Base URL of the FastAPI backend, WITHOUT a trailing slash and WITHOUT /api.
#
# Local dev: leave this blank. Vite proxies /api -> http://127.0.0.1:8000
# (see vite.config.js), which keeps the browser same-origin and sidesteps CORS.
#
# Production (Vercel): set this to your Render URL, e.g.
#   VITE_API_URL=https://study-planner-api.onrender.com
VITE_API_URL=

# Optional: point the dev proxy somewhere other than 127.0.0.1:8000
# (e.g. a teammate's machine on the LAN).
VITE_DEV_BACKEND=http://127.0.0.1:8000
